{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskpulse.dev/contracts/task-events/v1/task-assigned.schema.json",
  "title": "TaskAssignedV1",
  "description": "A task was assigned to a user in TaskPulse.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "producer",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "task.assigned"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "taskpulse"
    },
    "data": {
      "type": "object",
      "required": [
        "taskId",
        "projectId",
        "workspaceId",
        "assigneeId",
        "taskTitle"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "workspaceId": {
          "type": "string",
          "format": "uuid"
        },
        "assigneeId": {
          "type": "string",
          "format": "uuid"
        },
        "taskTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    }
  }
}